{
  "id": "bound-to-the-mast",
  "order": 3,
  "title": "Bound to the Mast",
  "book": "Book XII",
  "blurb": "Sail past the Sirens. One sings, one is tied up, one must keep rowing.",
  "difficulty": "Medium",
  "video": null,
  "duration": 45.7,
  "characters": [
    {
      "id": "odysseus",
      "name": "Odysseus",
      "description": "Tied to the mast and losing his mind."
    },
    {
      "id": "siren",
      "name": "Siren",
      "description": "An irresistible, terrifying singer."
    },
    {
      "id": "eurylochus",
      "name": "Eurylochus",
      "description": "First mate. Ears full of beeswax."
    }
  ],
  "lines": [
    {
      "character": "odysseus",
      "text": "Bind me to the mast, hand and foot, and if I beg you to set me free, bind me all the tighter.",
      "emotion": "resolve",
      "direction": "Arms behind your back, as if tied.",
      "start": 1.5,
      "end": 8.68
    },
    {
      "character": "siren",
      "text": "Come here, renowned Odysseus, honour to the Achaean name. Stay your ship and listen to our voices.",
      "emotion": "cunning",
      "direction": "Beckon slowly. Sing it if you dare.",
      "start": 9.58,
      "end": 17.76
    },
    {
      "character": "siren",
      "text": "No one ever sailed past us without staying to hear our sweet song, and he went on his way a wiser man.",
      "emotion": "longing",
      "direction": "Reach out toward Odysseus.",
      "start": 18.66,
      "end": 27.91
    },
    {
      "character": "odysseus",
      "text": "Untie me! Untie me, I command you! I must hear the rest of their song!",
      "emotion": "longing",
      "direction": "Strain against the ropes.",
      "start": 28.81,
      "end": 33.89
    },
    {
      "character": "eurylochus",
      "text": "Row harder, men! Bind him tighter! Do not look back!",
      "emotion": "resolve",
      "direction": "Row like your life depends on it. It does.",
      "start": 34.79,
      "end": 38.69
    },
    {
      "character": "odysseus",
      "text": "The song is fading. Thank you, Eurylochus. You have saved us all.",
      "emotion": "awe",
      "direction": "Slump. Exhausted. Grateful.",
      "start": 39.59,
      "end": 44.74
    }
  ],
  "source": "Homer, The Odyssey, tr. Samuel Butler (public domain), adapted",
  "reference": null,
