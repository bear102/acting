{
  "id": "secret-of-the-bed",
  "order": 4,
  "title": "The Secret of the Bed",
  "book": "Book XXIII",
  "blurb": "Twenty years gone. Penelope sets one last test only the true Odysseus can pass.",
  "difficulty": "Hard",
  "video": null,
  "duration": 47.3,
  "characters": [
    {
      "id": "penelope",
      "name": "Penelope",
      "description": "Wise, wary, and testing a stranger."
    },
    {
      "id": "odysseus",
      "name": "Odysseus",
      "description": "Home at last, and outraged about furniture."
    }
  ],
  "lines": [
    {
      "character": "penelope",
      "text": "Eurycleia, take the strong bed out of the bed chamber that he himself built.",
      "emotion": "cunning",
      "direction": "Cool and calm. Watch him from the corner of your eye.",
      "start": 1.5,
      "end": 7.53
    },
    {
      "character": "odysseus",
      "text": "Wife, I am much displeased at what you have just been saying. Who has been taking my bed from the place in which I left it?",
      "emotion": "rage",
      "direction": "Explode. Point accusingly.",
      "start": 8.43,
      "end": 16.44
    },
    {
      "character": "odysseus",
      "text": "I built it myself around the trunk of an olive tree. That is the secret of our bed.",
      "emotion": "resolve",
      "direction": "Shape the tree trunk with your hands.",
      "start": 17.34,
      "end": 23.18
    },
    {
      "character": "penelope",
      "text": "Do not be angry with me, Odysseus. The gods have been very cruel to us.",
      "emotion": "sorrow",
      "direction": "Your guard drops. Step toward him.",
      "start": 24.08,
      "end": 30.06
    },
    {
      "character": "penelope",
      "text": "You have convinced me. It is you. You have come home at last.",
      "emotion": "joy",
      "direction": "Tears of joy. Open your arms.",
      "start": 30.96,
      "end": 39.56
    },
    {
      "character": "odysseus",
      "text": "Then come, wife. We have endured so much, and now we are together.",
      "emotion": "joy",
      "direction": "Embrace. Hold the moment.",
      "start": 40.46,
      "end": 46.32
    }
  ],
  "source": "Homer, The Odyssey, tr. Samuel Butler (public domain), adapted",
  "reference": null,
