# Copy to .env and fill in. Every key is optional: the game still runs without them,
# falling back to browser speech recognition, canned god quips and a local scores file.

# ElevenLabs: Scribe speech-to-text (scores your lines)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Gemini: watches snapshots of your performance and writes the gods' commentary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas: Hall of Heroes leaderboard
MONGODB_URI=
MONGODB_DB=trials_of_odysseus
